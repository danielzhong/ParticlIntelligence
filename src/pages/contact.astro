---
import PageLayout from "../layouts/PageLayout.astro";
import { site } from "../config/site";
---

<PageLayout
  name="Contact"
  nameZh="联系我们"
  description="Contact the Particle Intelligence research project for academic discussion and general inquiries."
  descriptionZh="联系 Particle Intelligence 研究项目，交流学术问题或一般咨询。"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow" data-zh="开始一场交流">
        START A CONVERSATION
      </span>
      <h1 data-zh="告诉我们你正在探索什么。">
        Tell us what you are exploring.
      </h1>
      <p
        class="page-lead"
        data-zh="Particle Intelligence 是一个颗粒科学研究项目。欢迎交流颗粒输运、检测和微流控方面的研究问题，分享学术观点，或对项目内容提出建议。"
      >
        Particle Intelligence is a research project in particle science. We
        welcome questions about particle transport, detection, and
        microfluidics, academic perspectives, and feedback on the ideas
        presented here.
      </p>
      <div class="contact-options">
        <article class="contact-option">
          <h2 data-zh="颗粒科学">Particle science</h2>
          <p data-zh="交流颗粒输运、检测与物理建模方面的研究问题。">
            Discuss research questions in particle transport, detection, and
            physical modeling.
          </p>
        </article>
        <article class="contact-option">
          <h2 data-zh="微流控概念">Microfluidic concepts</h2>
          <p data-zh="分享有关流道几何、流动行为与测量方法的学术观点。">
            Share academic perspectives on channel geometry, flow behavior, and
            measurement methods.
          </p>
        </article>
        <article class="contact-option">
          <h2 data-zh="学术交流">Academic exchange</h2>
          <p data-zh="推荐相关文献，或交流值得进一步探索的科学问题。">
            Suggest relevant literature or discuss scientific questions worth
            exploring.
          </p>
        </article>
        <article class="contact-option">
          <h2 data-zh="一般咨询">General inquiries</h2>
          <p data-zh="了解项目愿景，或对网站内容提出建议与更正。">
            Ask about the project’s direction or share feedback and corrections
            to the website.
          </p>
        </article>
      </div>
      <div class="contact-cta">
        <div>
          <h2 data-zh="直接发邮件给我们">Email us directly</h2>
          <p>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
        <a
          class="button button-primary"
          href={`mailto:${site.email}?subject=${encodeURIComponent(`${site.name} inquiry`)}`}
        >
          <span data-zh="发送邮件">Send an email</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>
