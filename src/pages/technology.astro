---
import PageLayout from "../layouts/PageLayout.astro";
import Icon from "../layouts/components/Icon.astro";
import { withBase } from "../lib/paths";

const videos = [
  "4dcc0c946960d6fe264371d63214e09d.mp4",
  "dfafea134f07df77524eb9eb0e9cb104.mp4",
  "f4997c4b96f6014cf07e2ec4d12a80a6.mp4",
];
---

<PageLayout
  name="Technology"
  nameZh="技术方向"
  description="Explore Phora particle behavior modeling and AI-assisted microfluidic chip design at Particle Intelligence."
  descriptionZh="了解 Particle Intelligence 正在开发的 Phora 颗粒行为建模，以及 AI 辅助微流控芯片设计方向。"
>
  <section class="section" id="phora">
    <div class="container">
      <span class="eyebrow" data-zh="颗粒行为建模 · 研发中">
        PARTICLE BEHAVIOR MODELING · IN DEVELOPMENT
      </span>
      <h1 data-zh="Phora：探索颗粒在不同环境中的行为。">
        Phora: explore particle behavior across environments.
      </h1>
      <p
        class="page-lead"
        data-zh="Phora 是我们正在开发的颗粒行为建模工具。我们将实验观察与物理建模、机器学习结合，探索颗粒在不同环境中的运动和分布。"
      >
        Phora is our particle behavior modeling tool in development. We bring
        experimental observations, physical modeling, and machine learning
        together to explore particle motion and distribution across
        environments.
      </p>

      <div class="demo-shell" aria-labelledby="phora-demo-title">
        <div class="demo-heading">
          <div>
            <span class="eyebrow" data-zh="产品介绍 · 研发中">
              PRODUCT OVERVIEW · IN DEVELOPMENT
            </span>
            <h2 id="phora-demo-title" data-zh="观看实验与模型预测的对照。">
              Compare an experiment with a model prediction.
            </h2>
          </div>
          <p data-zh="选择一段影像，观看真实实验和同一场景的 Phora 模型预测。">
            Select a recording to compare the experiment with the Phora model
            prediction for the same scene.
          </p>
        </div>

        <div class="demo-content">
          <div class="demo-tabs" role="group" aria-label="Choose a comparison video" data-zh-aria-label="选择对照视频">
            {videos.map((video, index) => (
              <button
                class="demo-tab"
                type="button"
                data-phora-video
                data-video-src={withBase(`/media/${video}`)}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span data-zh={`视频 ${index + 1}`}>Video {index + 1}</span>
              </button>
            ))}
          </div>
          <div class="comparison-labels">
            <span data-zh="真实实验结果">EXPERIMENT</span>
            <span data-zh="Phora 模型预测">PHORA MODEL PREDICTION</span>
          </div>
          <video
            id="phora-comparison-video"
            controls
            playsinline
            preload="metadata"
            src={withBase(`/media/${videos[0]}`)}
            aria-label="Phora experiment and model prediction comparison"
            data-zh-aria-label="Phora 实验与模型预测对照视频"
          >
            Your browser does not support embedded video.
          </video>
          <p class="demo-note" data-zh="模型演示从实验影像中的一个时刻初始化，不包含此后持续进入视野的颗粒。">
            The model demonstration is initialized from an experimental frame
            and does not include particles entering the field afterward.
          </p>
        </div>
      </div>

      <div class="contact-cta">
        <div>
          <h2 data-zh="想进一步了解 Phora？">Want to learn more about Phora?</h2>
          <p data-zh="欢迎联系 Particle Intelligence，讨论研究需求与合作机会。">
            Talk with Particle Intelligence about research needs and
            collaboration.
          </p>
        </div>
        <a class="button button-primary" href={withBase("/contact/")}>
          <span data-zh="联系团队">Contact the team</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <section class="section application-section" id="chips">
    <div class="container chip-design-layout">
      <div class="chip-design-copy">
        <span class="eyebrow" data-zh="微流控芯片设计 · 探索中">
          MICROFLUIDIC CHIP DESIGN · EXPLORING
        </span>
        <h2 data-zh="AI 辅助微流控芯片设计与 3D 打印。">
          AI-assisted microfluidic design and 3D printing.
        </h2>
        <p class="page-lead" data-zh="从实验需求出发，我们探索用 AI 辅助设计和 3D 打印制作微流控芯片原型，再用实验反馈改进下一版设计。">
          Starting with an experimental question, we explore AI-assisted design
          and 3D printing for microfluidic chip prototypes. Experimental
          feedback can inform the next design.
        </p>
        <a class="section-link" href={withBase("/contact/")}>
          <span data-zh="讨论芯片设计需求">Discuss chip design needs</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <figure class="chip-design-image">
        <img
          src={withBase("/media/chip.jpg")}
          alt="Microfluidic chip concept illustration"
          data-zh-alt="微流控芯片概念示意图"
          width="1254"
          height="1254"
          loading="lazy"
        />
        <figcaption data-zh="概念示意图">Concept illustration</figcaption>
      </figure>
    </div>
  </section>
</PageLayout>

<script>
  const player = document.querySelector<HTMLVideoElement>(
    "#phora-comparison-video",
  );
  document.querySelectorAll<HTMLButtonElement>("[data-phora-video]").forEach(
    (button) => {
      button.addEventListener("click", () => {
        if (!player || !button.dataset.videoSrc) return;
        document
          .querySelectorAll<HTMLButtonElement>("[data-phora-video]")
          .forEach((tab) =>
            tab.setAttribute("aria-pressed", String(tab === button)),
          );
        player.pause();
        player.currentTime = 0;
        player.src = button.dataset.videoSrc;
        player.load();
      });
    },
  );
</script>
