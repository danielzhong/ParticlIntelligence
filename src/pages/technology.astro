---
import PageLayout from "../layouts/PageLayout.astro";
import MicrofluidicChip from "../layouts/components/MicrofluidicChip.astro";
import "../styles/research-editorial.css";
import Icon from "../layouts/components/Icon.astro";
import { withBase } from "../lib/paths";
---

<PageLayout
  name="Technology"
  nameZh="技术方向"
  description="Explore Phora particle behavior modeling and AI-assisted microfluidic chip design at Particle Intelligence."
  descriptionZh="了解 Particle Intelligence 的 Phora 研究概念，以及颗粒行为建模与微流控设计的长期愿景。"
>
  <section class="section" id="phora">
    <div class="container">
      <span class="eyebrow" data-zh="颗粒行为建模 · 研究概念">
        PARTICLE BEHAVIOR MODELING · RESEARCH CONCEPT
      </span>
      <h1 data-zh="Phora：探索颗粒在不同环境中的行为。">
        Phora: explore particle behavior across environments.
      </h1>
      <p
        class="page-lead"
        data-zh="Phora 是一个颗粒行为建模研究概念，关注物理建模、机器学习与实验观察之间的联系。它代表一个长期研究方向，尚不是经过验证或可供使用的商业产品。"
      >
        Phora is a research concept for particle behavior modeling, centered on
        the connections between physical models, machine learning, and
        experimental observations. It represents a long-term research direction,
        not a validated or available commercial product.
      </p>

      <section class="model-simulation" aria-labelledby="simulation-title">
        <div class="simulation-heading">
          <div>
            <span class="eyebrow" data-zh="PHORA · 合成数据">
              PHORA · SYNTHETIC DATA
            </span>
            <h2 id="simulation-title" data-zh="模型模拟示意">
              Model simulation
            </h2>
          </div>
          <div
            class="demo-tabs"
            role="group"
            aria-label="Choose a model simulation"
            data-zh-aria-label="选择模型模拟示意"
          >
            {[1, 2, 3].map((number) => (
              <button
                type="button"
                class="demo-tab"
                data-model-simulation
                data-video-src={withBase(
                  `/media/phora-simulation-0${number}.mp4`,
                )}
                data-video-poster={withBase(
                  `/media/phora-simulation-0${number}.jpg`,
                )}
                aria-pressed={number === 1 ? "true" : "false"}
              >
                <span data-zh={`模拟 ${number}`}>Simulation {number}</span>
              </button>
            ))}
          </div>
        </div>
        <video
          id="phora-simulation"
          controls
          playsinline
          preload="none"
          poster={withBase("/media/phora-simulation-01.jpg")}
          src={withBase("/media/phora-simulation-01.mp4")}
          aria-label="Phora model simulation using synthetic data"
          data-zh-aria-label="使用合成数据的 Phora 模型模拟示意"
          aria-describedby="simulation-note"
        >
          <p data-zh="你的浏览器不支持内嵌视频。">
            Your browser does not support embedded video.
          </p>
        </video>
        <p
          id="simulation-note"
          class="simulation-note"
          data-zh="使用自行生成的初始条件与合成数据的模型模拟示意。画面仅展示模拟输出，不包含实验影像，也不代表实验验证结果或产品性能评估。"
        >
          Illustrative model simulations using self-generated initial conditions
          and synthetic data. These clips show simulation output only; they
          contain no experimental footage and do not represent experimental
          validation or a product performance evaluation.
        </p>
      </section>

      <section class="research-concept" aria-labelledby="phora-questions">
        <div class="research-concept-heading">
          <span class="eyebrow" data-zh="值得探索的问题">
            QUESTIONS TO EXPLORE
          </span>
          <h2 id="phora-questions" data-zh="从运动轨迹，到更深的理解。">
            From trajectories to understanding.
          </h2>
        </div>
        <div class="research-concept-grid">
          <article>
            <span class="research-concept-index" aria-hidden="true">
              01
            </span>
            <h3 data-zh="颗粒输运">Particle transport</h3>
            <p data-zh="流动条件、几何结构与材料相互作用，会怎样影响颗粒的运动和分布？">
              How do flow conditions, geometry, and material interactions shape
              particle motion and distribution?
            </p>
          </article>
          <article>
            <span class="research-concept-index" aria-hidden="true">
              02
            </span>
            <h3 data-zh="颗粒检测">Particle detection</h3>
            <p data-zh="影像中的哪些信息有助于识别颗粒，并区分真实运动与测量噪声？">
              What information in an image helps identify particles and
              distinguish their motion from measurement noise?
            </p>
          </article>
          <article>
            <span class="research-concept-index" aria-hidden="true">
              03
            </span>
            <h3 data-zh="物理与学习">Physics & learning</h3>
            <p data-zh="物理约束如何帮助解释数据中的规律，并评估模型在不同条件下的适用范围？">
              How could physical constraints help interpret patterns in data and
              assess a model’s limits across different conditions?
            </p>
          </article>
        </div>
      </section>

      <div class="contact-cta">
        <div>
          <h2 data-zh="想进一步了解 Phora？">
            Want to learn more about Phora?
          </h2>
          <p data-zh="欢迎交流颗粒行为的研究问题与学术观点。">
            Share research questions and academic perspectives on particle
            behavior.
          </p>
        </div>
        <a class="button button-primary" href={withBase("/contact/")}>
          <span data-zh="联系团队">Contact the team</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>

  <section class="section application-section" id="chips">
    <div class="container chip-design-layout">
      <div class="chip-design-copy">
        <span class="eyebrow" data-zh="微流控芯片设计 · 探索中">
          MICROFLUIDIC CHIP DESIGN · EXPLORING
        </span>
        <h2 data-zh="AI 辅助微流控芯片设计与 3D 打印。">
          AI-assisted microfluidic design and 3D printing.
        </h2>
        <p
          class="page-lead"
          data-zh="微流控芯片设计是一个可能的未来方向：探索 AI 辅助几何设计、制造方法与实验反馈之间的联系。下方为通用流道结构示意，不代表已制造的设备。"
        >
          A possible future direction is to explore connections between
          AI-assisted geometry design, fabrication methods, and experimental
          feedback. The illustration shows a generic channel structure, not a
          fabricated device.
        </p>
        <a class="section-link" href={withBase("/contact/")}>
          <span data-zh="交流微流控研究问题">
            Discuss microfluidic research questions
          </span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <MicrofluidicChip id="technology-chip" />
    </div>
  </section>
</PageLayout>

<script>
  const player = document.querySelector<HTMLVideoElement>("#phora-simulation");
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    "[data-model-simulation]",
  );
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      if (
        !player ||
        !button.dataset.videoSrc ||
        button.getAttribute("aria-pressed") === "true"
      )
        return;
      player.pause();
      buttons.forEach((item) =>
        item.setAttribute("aria-pressed", String(item === button)),
      );
      player.poster = button.dataset.videoPoster || "";
      player.src = button.dataset.videoSrc;
      player.load();
    });
  });
</script>
