---
import Base from "../layouts/Base.astro";
import ParticleScene from "../layouts/components/ParticleScene.astro";
import MicrofluidicChip from "../layouts/components/MicrofluidicChip.astro";
import { withBase } from "../lib/paths";
import { site } from "../config/site";
import "../styles/home-redesign.css";
---

<Base>
  <section class="pi-hero">
    <div class="container pi-hero-grid">
      <div class="pi-hero-copy">
        <p class="pi-kicker" data-zh="颗粒输运 × 颗粒检测">
          PARTICLE TRANSPORT × PARTICLE DETECTION
        </p>
        <h1 data-zh="看见颗粒如何运动。<br/><em>探索接下来的可能性。</em>">
          See how particles move.
          <br />
          <em>Explore what comes next.</em>
        </h1>
        <p class="pi-hero-tagline" data-zh={site.taglineZh}>
          {site.tagline}
        </p>
        <div class="pi-actions">
          <a
            class="pi-button"
            href={withBase("/technology/#phora")}
            data-zh="认识 Phora"
          >
            Meet Phora
          </a>
          <a
            class="pi-text-link"
            href={withBase("/technology/")}
            data-zh="探索技术方向"
          >
            Explore the science
          </a>
        </div>
        <p class="pi-stage" data-zh="研发中 · 欢迎研究合作交流">
          In development · Open to research conversations
        </p>
      </div>
      <ParticleScene />
    </div>
    <div class="container pi-hero-bottom">
      <span data-zh="物理、实验与人工智能，在微观尺度相遇。">
        Physics, experiments & AI. Connected at the microscale.
      </span>
      <a href="#perspective" data-zh="向下探索 ↓">
        SCROLL TO EXPLORE ↓
      </a>
    </div>
  </section>
  <section class="pi-statement" id="perspective">
    <div class="container pi-statement-grid">
      <p class="pi-kicker" data-zh="我们的研究出发点">
        THE QUESTION BEHIND OUR WORK
      </p>
      <div>
        <h2 data-zh="看见运动，<br/><em>只是开始。</em>">
          Seeing motion
          <br />
          <em>is just the beginning.</em>
        </h2>
        <p data-zh="颗粒的路径蕴含着它与周围环境相互作用的信息。我们将实验、物理建模和机器学习结合，探索如何从观察中获得更深入的理解。">
          A particle’s path holds clues to how it interacts with its
          surroundings. We bring experiments, physical modeling, and machine
          learning together to explore what those observations can tell us.
        </p>
      </div>
    </div>
    <div class="container pi-disciplines">
      <article>
        <span class="pi-kicker" data-zh="颗粒输运">
          PARTICLE TRANSPORT
        </span>
        <h3 data-zh="理解运动的路径。">Understand the paths.</h3>
        <p data-zh="探索颗粒如何在流体、材料和不同几何结构中运动与分布。">
          Explore how particles move and distribute through fluids, materials,
          and geometries.
        </p>
      </article>
      <article>
        <span class="pi-kicker" data-zh="颗粒检测">
          PARTICLE DETECTION
        </span>
        <h3 data-zh="发现观察中的信号。">Find the signal.</h3>
        <p data-zh="探索如何从实验影像与颗粒观测中提取有用信息。">
          Explore how experimental images and particle observations can reveal
          useful information.
        </p>
      </article>
    </div>
  </section>
  <section class="pi-phora-intro">
    <div class="container pi-phora-intro-grid">
      <div>
        <p class="pi-kicker" data-zh="认识 PHORA">
          INTRODUCING PHORA
        </p>
        <h2 data-zh="从观察，<br/><em>走向理解。</em>">
          From observation
          <br />
          <em>to understanding.</em>
        </h2>
      </div>
      <div>
        <p data-zh="Phora 将实验观察、物理建模与机器学习相连接，探索颗粒运动背后的规律。">
          Phora connects experimental observation with physical modeling and
          machine learning to explore the patterns behind particle motion.
        </p>
        <a
          class="pi-text-link"
          href={withBase("/technology/#phora")}
          data-zh="了解 Phora 与实验影像 ↗"
        >
          Discover Phora & the experiments ↗
        </a>
        <span class="pi-stage" data-zh="研发中">
          In development
        </span>
      </div>
    </div>
  </section>
  <section class="pi-design">
    <div class="container pi-design-grid">
      <MicrofluidicChip id="home-chip" />
      <div>
        <p class="pi-kicker" data-zh="与建模相连接的研发方向">
          A CONNECTED RESEARCH DIRECTION
        </p>
        <h2 data-zh="从研究问题，<br/>走向芯片设计。">
          From a question
          <br />
          to a chip.
        </h2>
        <p
          class="pi-copy"
          data-zh="我们正在探索 AI 辅助设计与 3D 打印，帮助微流控芯片从概念走向原型，再让实验反馈启发下一轮设计。"
        >
          We’re exploring AI-assisted design and 3D printing to move
          microfluidic concepts toward prototypes, with experimental feedback
          informing the next design.
        </p>
        <a
          class="pi-text-link"
          href={withBase("/technology/#chips")}
          data-zh="探索芯片设计"
        >
          Explore chip design
        </a>
      </div>
    </div>
  </section>
  <section class="pi-research">
    <div class="container">
      <div class="pi-section-head">
        <div>
          <p class="pi-kicker" data-zh="正在探索的研究问题">
            QUESTIONS WE’RE EXPLORING
          </p>
          <h2 data-zh="微观世界。<br/>更广阔的问题。">
            Small scale.
            <br />
            Wider questions.
          </h2>
        </div>
        <p data-zh="这些场景引导着我们的研究方向，尚不代表已验证的产品应用。">
          These contexts guide our research. They are areas of exploration, not
          validated product applications.
        </p>
      </div>
      <div class="pi-research-list">
        <a href={withBase("/applications/#drug-delivery")}>
          <span class="pi-research-name" data-zh="药物输运与递送">
            Drug transport & delivery
          </span>
          <span data-zh="颗粒会在哪里聚集，又如何分散？">
            Where do particles accumulate—and disperse?
          </span>
          <span class="pi-research-tag" data-zh="探索中">
            EXPLORING
          </span>
        </a>
        <a href={withBase("/applications/#textile-cleaning")}>
          <span class="pi-research-name" data-zh="纺织纤维清洁">
            Textile & fiber cleaning
          </span>
          <span data-zh="颗粒如何与纤维相互作用？">
            How do particles interact with fibers?
          </span>
          <span class="pi-research-tag" data-zh="探索中">
            EXPLORING
          </span>
        </a>
        <a href={withBase("/applications/#semiconductor-sensing")}>
          <span class="pi-research-name" data-zh="半导体颗粒传感">
            Semiconductor particle sensing
          </span>
          <span data-zh="怎样更好地理解颗粒计数信号？">
            What can particle-count signals tell us?
          </span>
          <span class="pi-research-tag" data-zh="探索中">
            EXPLORING
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="pi-team">
    <div class="container pi-team-grid">
      <p class="pi-kicker" data-zh="跨学科团队">
        AT THE INTERSECTION
      </p>
      <div>
        <h2 data-zh="物理学家的好奇心。<br/>工程师的实践精神。">
          The curiosity of physicists.
          <br />
          The craft of engineers.
        </h2>
        <p
          class="pi-copy"
          data-zh="我们的创始团队将颗粒输运、实验科学、计算建模和人工智能的研究经验带到同一个问题面前。"
        >
          Our founding team brings research experience in particle transport,
          experimental science, computational modeling, and artificial
          intelligence to a shared set of questions.
        </p>
        <a
          class="pi-text-link"
          href={withBase("/about/")}
          data-zh="认识创始团队"
        >
          Meet the founders
        </a>
      </div>
    </div>
  </section>
  <section class="pi-invitation">
    <div class="container">
      <p class="pi-kicker" data-zh="欢迎研究合作交流">
        LET’S EXPLORE TOGETHER
      </p>
      <h2 data-zh="你的下一个问题，<br/><em>从哪里开始？</em>">
        What’s your
        <br />
        <em>next question?</em>
      </h2>
      <div class="pi-invitation-bottom">
        <p data-zh="如果你正在研究颗粒行为或微流控实验，欢迎与我们交流研究需求与合作想法。">
          Working on particle behavior or microfluidic experiments? We’d like to
          hear about your research and collaboration ideas.
        </p>
        <a class="pi-button" href={withBase("/contact/")} data-zh="与团队交流">
          Start a conversation
        </a>
      </div>
    </div>
  </section>
</Base>
