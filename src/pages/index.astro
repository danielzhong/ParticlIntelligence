---
import Base from "../layouts/Base.astro";
import Badge from "../layouts/components/Badge.astro";
import Icon from "../layouts/components/Icon.astro";
import FlowField from "../layouts/components/FlowField.astro";
import { withBase } from "../lib/paths";
import { site } from "../config/site";
import "../styles/platform.css";
import "../styles/pages.css";
---

<Base>
  <section class="hero platform-hero">
    <div class="hero-halo" aria-hidden="true"></div>
    <FlowField />
    <div class="container hero-content">
      <Badge title="Particle Intelligence" zh="Particle Intelligence" />
      <h1 data-zh="看见颗粒如何运动。<br /><span>探索接下来的可能性。</span>">
        See how particles move.
        <br />
        <span>Explore what comes next.</span>
      </h1>
      <p class="hero-tagline" data-zh="理解颗粒行为，探索微尺度的可能性。">
        Understand particle behavior. Explore possibilities at the microscale.
      </p>
      <p class="hero-description" data-zh={site.descriptionZh}>
        {site.description}
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href={withBase("/technology/")}>
          <span data-zh="探索我们的技术">Explore Our Technology</span>
          <Icon name="arrow" size={19} />
        </a>
        <a class="button button-outline" href={withBase("/contact/")}>
          <span data-zh="与我们合作">Partner With Us</span>
          <Icon name="diagonal" size={18} />
        </a>
      </div>
      <div class="hero-footnote">
        <span></span>
        <span data-zh="面向科研与产业的研发方向">
          Research and industry, connected at the microscale
        </span>
      </div>
    </div>
  </section>

  <section class="home-intro">
    <div class="container home-intro-copy">
      <span class="eyebrow" data-zh="颗粒智能的新方法">A NEW APPROACH TO PARTICLE INTELLIGENCE</span>
      <h2 data-zh="颗粒建模与微流控设计。">Particle modeling and microfluidic design.</h2>
      <p data-zh={site.descriptionZh}>{site.description}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="directions-heading">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow" data-zh="两项相互关联的研发方向">TWO CONNECTED DIRECTIONS</span>
          <h2 id="directions-heading" data-zh="从预测颗粒行为，到设计实验工具。">
            From predicting particle behavior to designing experimental tools.
          </h2>
        </div>
      </div>
      <div class="direction-grid">
        <article class="direction-card">
          <span class="direction-number">01 / PHORA</span>
          <h3 data-zh="探索颗粒如何运动与分布。">
            Explore how particles move and distribute.
          </h3>
          <p data-zh="Phora 是我们正在开发的颗粒行为建模工具，旨在帮助研究人员探索不同环境下的颗粒运动和分布。">
            Phora is our particle behavior modeling tool in development, intended to help researchers explore particle motion and distributions in different environments.
          </p>
          <a href={withBase("/technology/")}>
            <span data-zh="了解 Phora">Discover Phora</span>
            <Icon name="arrow" size={18} />
          </a>
        </article>
        <article class="direction-card">
          <span class="direction-number" data-zh="02 / 微流控芯片">02 / MICROFLUIDICS</span>
          <h3 data-zh="从实验需求走向芯片原型。">
            Move from experimental needs toward chip prototypes.
          </h3>
          <p data-zh="从实验需求出发，我们探索将 AI 辅助设计、建模和 3D 打印结合，推动微流控芯片概念向原型转化。">
            Starting with experimental needs, we explore how AI-assisted design, modeling, and 3D printing can help move microfluidic chip concepts toward prototypes.
          </p>
          <a href={withBase("/technology/#microfluidics")}>
            <span data-zh="了解芯片设计方向">Explore chip design</span>
            <Icon name="arrow" size={18} />
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="section application-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow" data-zh="正在探索的应用方向">AREAS OF EXPLORATION</span>
          <h2 data-zh="从研究问题出发。">Start with the research question.</h2>
        </div>
        <a class="section-link" href={withBase("/applications/")}>
          <span data-zh="查看应用方向">View applications</span>
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <div class="application-grid">
        <article class="application-card">
          <span class="application-label" data-zh="正在探索">IN EXPLORATION</span>
          <h2 data-zh="药物输运与递送">Drug transport & delivery</h2>
          <p data-zh="研究颗粒特性与微环境如何影响输运和递送问题。">
            Explore how particle properties and microenvironments shape transport and delivery questions.
          </p>
        </article>
        <article class="application-card">
          <span class="application-label" data-zh="正在探索">IN EXPLORATION</span>
          <h2 data-zh="纺织纤维清洁">Textile & fiber cleaning</h2>
          <p data-zh="探索颗粒与纤维之间的相互作用，以及微流控实验如何帮助观察这些过程。">
            Explore particle and fiber interactions, and how microfluidic experiments may help study them.
          </p>
        </article>
        <article class="application-card">
          <span class="application-label" data-zh="正在探索">IN EXPLORATION</span>
          <h2 data-zh="半导体颗粒传感">Particle sensing for semiconductors</h2>
          <p data-zh="探索颗粒行为建模和实验设计在半导体颗粒检测问题中的潜在作用。">
            Explore potential roles for particle modeling and experimental design in semiconductor particle sensing.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="vision-band">
    <div class="container vision-inner">
      <div>
        <span class="eyebrow" data-zh="长期方向">LONG-TERM VISION</span>
        <h2>Predict. Design. Learn.</h2>
        <div class="vision-steps" aria-label="Predict, Design, Learn">
          <span data-zh="预测">PREDICT</span>
          <span data-zh="设计">DESIGN</span>
          <span data-zh="学习">LEARN</span>
        </div>
      </div>
      <p data-zh="这是 Particle Intelligence 的长期产品愿景。我们正围绕研究需求探索这些方向，并会根据研发进展逐步推进。">
        This is Particle Intelligence’s long-term product vision. We are exploring these directions around research needs and will advance them as development progresses.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-cta">
      <div>
        <h2 data-zh="有研究问题或合作想法？">Have a research question or a collaboration in mind?</h2>
        <p data-zh="欢迎科研、芯片设计、产业与投资相关咨询。">
          We welcome research, chip design, industry, and investment inquiries.
        </p>
      </div>
      <a class="button button-primary" href={withBase("/contact/")}>
        <span data-zh="联系我们">Contact us</span>
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
</Base>
