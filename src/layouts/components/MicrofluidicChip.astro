---
interface Props {
  id?: string;
}
const { id = "microfluidic-chip" } = Astro.props;
const channel =
  "M120 240H270Q290 240 307 222L370 155Q385 140 405 140H440 M270 240Q290 240 307 258L370 325Q385 340 405 340H440";
---

<figure class="microfluidic-study">
  <svg
    viewBox="0 0 640 520"
    role="img"
    aria-label="Transparent microfluidic chip with one inlet and two connected outlet branches"
    data-zh-aria-label="透明微流控基片，一条入口流道连通两个出口支路"
  >
    <defs>
      <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
        <stop stop-color="#f2f1ed" stop-opacity=".65" />
        <stop offset=".48" stop-color="#cbd3d3" stop-opacity=".12" />
        <stop offset="1" stop-color="#f1f0e9" stop-opacity=".4" />
      </linearGradient>
      <linearGradient id={`${id}-edge`}>
        <stop stop-color="#8a9698" stop-opacity=".6" />
        <stop offset=".45" stop-color="#eff3ef" stop-opacity=".85" />
        <stop offset="1" stop-color="#7e8c8d" stop-opacity=".65" />
      </linearGradient>
      <filter id={`${id}-shadow`} x="-30%" y="-30%" width="170%" height="190%">
        <feGaussianBlur stdDeviation="12" />
      </filter>
    </defs>
    <ellipse
      cx="332"
      cy="381"
      rx="206"
      ry="66"
      fill="#000"
      opacity=".2"
      filter={`url(#${id}-shadow)`}
    />
    <g transform="matrix(.95 .28 -.45 .78 135 25)">
      <path
        d="M520 60V420L527 438V78Z"
        fill="#8c9a9b"
        fill-opacity=".12"
        stroke={`url(#${id}-edge)`}
      />
      <path
        d="M50 420H520L527 438H57Z"
        fill="#abb6b8"
        fill-opacity=".18"
        stroke={`url(#${id}-edge)`}
      />
      <rect
        x="50"
        y="60"
        width="470"
        height="360"
        rx="7"
        fill={`url(#${id}-glass)`}
        stroke="#d7e1dc"
        stroke-opacity=".75"
        stroke-width="1.5"
      />
      <rect
        x="57"
        y="67"
        width="456"
        height="346"
        rx="4"
        fill="none"
        stroke="#f2f3ed"
        stroke-opacity=".18"
      />
      <path
        d={channel}
        fill="none"
        stroke="#182b32"
        stroke-opacity=".65"
        stroke-width="18"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d={channel}
        fill="none"
        stroke="#a6bdc1"
        stroke-width="13"
        stroke-opacity=".55"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d={channel}
        fill="none"
        stroke="#21343b"
        stroke-width="9"
        stroke-opacity=".7"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      {[
        [120, 240],
        [440, 140],
        [440, 340],
      ].map(([x, y]) => (
        <g>
          <circle
            cx={x}
            cy={y}
            r="23"
            fill="#15262d"
            fill-opacity=".9"
            stroke="#d1dddb"
            stroke-width="2"
          />
          <circle
            cx={x}
            cy={y + 3}
            r="17"
            fill="#273b42"
            stroke="#9faeaf"
            stroke-width="1"
          />
          <path
            d={`M${x - 19} ${y - 7}A20 20 0 0 1 ${x + 18} ${y - 8}`}
            fill="none"
            stroke="#f1f3ed"
            stroke-opacity=".9"
            stroke-width="2"
          />
        </g>
      ))}
      <g fill="#d3c4df">
        {[
          [165, 240],
          [200, 240],
          [244, 240],
          [287, 232],
          [325, 203],
          [359, 167],
          [407, 140],
          [291, 248],
          [336, 289],
          [377, 331],
          [410, 340],
        ].map(([x, y], i) => (
          <circle cx={x} cy={y} r={i % 3 === 0 ? 2 : 1.4} />
        ))}
      </g>
      <g
        fill="#e9edeb"
        opacity=".6"
        font-size="10"
        font-family="monospace"
        letter-spacing="1.5"
      >
        <text x="102" y="199">
          IN
        </text>
        <text x="420" y="98">
          OUT 01
        </text>
        <text x="418" y="389">
          OUT 02
        </text>
      </g>
    </g>
  </svg>
  <figcaption>
    <span data-zh="分叉微流道">A branching microchannel</span>
    <span data-zh="结构示意">STRUCTURAL SCHEMATIC</span>
  </figcaption>
</figure>
<style>
  .microfluidic-study {
    margin: 0;
    min-width: 0;
    background: radial-gradient(
      ellipse at 50% 55%,
      #2c3038 0,
      #171b23 65%,
      #141820 100%
    );
    padding: 16px 20px 25px;
    border: 1px solid #ffffff09;
    border-radius: 2px;
  }
  .microfluidic-study svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .microfluidic-study figcaption {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-align: center;
    color: #d0d3d4;
    font-size: 14px;
    line-height: 1.5;
  }
  .microfluidic-study figcaption span:last-child {
    font-size: 8px;
    letter-spacing: 0.11em;
    color: #a4adb5;
  }
</style>
